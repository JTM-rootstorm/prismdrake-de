{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismdrake.org/schemas/test/pd2-portage-lifecycle-evidence-v1.json",
  "title": "Prismdrake PD2 Portage installed lifecycle evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "source",
    "resolutions",
    "tested_artifact",
    "package_test",
    "initial_install",
    "direct_linkage",
    "sandbox_exclusions",
    "installed_demonstrations",
    "unmerge",
    "ordinary_reinstall"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_kind": { "const": "pd2_portage_installed_lifecycle" },
    "source": { "$ref": "#/$defs/source" },
    "resolutions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/resolution" }
    },
    "tested_artifact": { "$ref": "#/$defs/tested_artifact" },
    "package_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "ebuild_sha256", "artifact_sha256", "features_test", "result", "executed_test_count", "excluded_tests"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "features_test": { "const": true },
        "result": { "const": "passed" },
        "executed_test_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "excluded_tests": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/excluded_test_id" }
        }
      }
    },
    "initial_install": { "$ref": "#/$defs/full_install" },
    "direct_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "ebuild_sha256", "artifact_sha256", "tool", "capture_sha256", "entries"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "tool": { "const": "scanelf" },
        "capture_sha256": { "$ref": "#/$defs/sha256" },
        "entries": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/linkage_entry" }
        }
      }
    },
    "sandbox_exclusions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/sandbox_exclusion" }
    },
    "installed_demonstrations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/demonstration" }
    },
    "unmerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "ebuild_sha256", "artifact_sha256", "atom", "result", "owned_removable_paths_absent", "absent_path_count", "removable_path_set_sha256", "user_data"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "atom": { "const": "x11-misc/prismdrake" },
        "result": { "const": "passed" },
        "owned_removable_paths_absent": { "const": true },
        "absent_path_count": { "type": "integer", "minimum": 5, "maximum": 4096 },
        "removable_path_set_sha256": { "$ref": "#/$defs/sha256" },
        "user_data": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/user_data_hash" }
        }
      }
    },
    "ordinary_reinstall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "ebuild_sha256", "artifact_sha256", "provenance", "use_test", "result", "executables", "ownership"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "provenance": { "const": "portage_installed" },
        "use_test": { "const": false },
        "result": { "const": "passed" },
        "executables": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/executable" }
        },
        "ownership": { "$ref": "#/$defs/full_ownership" }
      }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "repository_uri", "repository_name", "atom", "version", "ebuild_path", "ebuild_sha256", "bundle_sha256"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "repository_uri": { "const": "https://github.com/JTM-rootstorm/prismdrake-de.git" },
        "repository_name": { "const": "prismdrake-local" },
        "atom": { "const": "x11-misc/prismdrake" },
        "version": { "const": "9999" },
        "ebuild_path": { "const": "x11-misc/prismdrake/prismdrake-9999.ebuild" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tested_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "ebuild_sha256", "atom", "provenance", "use_test", "artifact_sha256"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "atom": { "const": "x11-misc/prismdrake-9999" },
        "provenance": { "const": "portage_installed" },
        "use_test": { "const": true },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_revision", "ebuild_sha256", "use_test", "result", "dependency_graph_sha256"],
      "properties": {
        "mode": { "enum": ["default", "use_test"] },
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "use_test": { "type": "boolean" },
        "result": { "const": "resolved" },
        "dependency_graph_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "installed_executable_path": {
      "enum": [
        "/usr/bin/prismdrake-session",
        "/usr/bin/prismdrake-settingsd",
        "/usr/bin/prismdrake-notifyd",
        "/usr/bin/prismdrake-shell",
        "/usr/bin/prismdrake-shellctl"
      ]
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "regular_executable"],
      "properties": {
        "path": { "$ref": "#/$defs/installed_executable_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "regular_executable": { "const": true }
      }
    },
    "owned_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["directory", "regular", "symlink"] },
        "path": { "type": "string", "minLength": 5, "maxLength": 512, "pattern": "^/usr(?:/[A-Za-z0-9._+@-]+)+$" }
      }
    },
    "full_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "owner_atom", "path_count", "regular_path_count", "path_set_sha256", "regular_path_set_sha256", "paths"],
      "properties": {
        "tool": { "const": "equery" },
        "owner_atom": { "const": "x11-misc/prismdrake-9999" },
        "path_count": { "type": "integer", "minimum": 5, "maximum": 4096 },
        "regular_path_count": { "type": "integer", "minimum": 5, "maximum": 4096 },
        "path_set_sha256": { "$ref": "#/$defs/sha256" },
        "regular_path_set_sha256": { "$ref": "#/$defs/sha256" },
        "paths": {
          "type": "array",
          "minItems": 5,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/owned_path" }
        }
      }
    },
    "full_install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "ebuild_sha256", "artifact_sha256", "provenance", "data_prefix", "build_provenance", "executables", "ownership"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "provenance": { "const": "portage_installed" },
        "data_prefix": { "const": "/usr/share/prismdrake" },
        "build_provenance": { "$ref": "#/$defs/build_provenance" },
        "executables": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/executable" }
        },
        "ownership": { "$ref": "#/$defs/full_ownership" }
      }
    },
    "linkage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "executable_sha256", "needed"],
      "properties": {
        "path": { "$ref": "#/$defs/installed_executable_path" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "needed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]*$" }
        }
      }
    },
    "build_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source_revision"],
      "properties": {
        "path": { "const": "/usr/share/prismdrake/build-provenance.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/revision" }
      }
    },
    "excluded_test_id": {
      "enum": [
        "DetachedApplicationTest.ExecutesExactArgvWorkingDirectoryAndEnvironmentWithoutShell",
        "LauncherPipelineTest.ExpandsPlansAndLaunchesLiteralArgumentsWithoutAShell",
        "X11DockOpenboxIntegrationTest",
        "TaskControllerOpenboxStabilizationIntegrationTest"
      ]
    },
    "sandbox_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "reason", "source_revision", "ebuild_sha256", "artifact_sha256", "execution_context", "result", "attempts", "passes"],
      "properties": {
        "test_id": { "$ref": "#/$defs/excluded_test_id" },
        "reason": { "enum": ["exact_child_environment", "openbox_preload_interference"] },
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "execution_context": { "const": "outside_portage_sandbox" },
        "result": { "const": "passed" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "passes": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "demonstration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "source_revision", "ebuild_sha256", "artifact_sha256", "result", "complete", "evidence_kind", "evidence_schema_version", "evidence_sha256", "normalized_results_sha256", "harness_manifest_sha256"],
      "properties": {
        "phase": { "enum": ["initial_install", "ordinary_reinstall"] },
        "source_revision": { "$ref": "#/$defs/revision" },
        "ebuild_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "result": { "const": "passed" },
        "complete": { "const": true },
        "evidence_kind": { "const": "pd2_installed_multi_output_failure_demonstration" },
        "evidence_schema_version": { "const": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "normalized_results_sha256": { "$ref": "#/$defs/sha256" },
        "harness_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "user_data_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "before_sha256", "after_sha256"],
      "properties": {
        "kind": { "enum": ["config_toml", "pins", "notification_history"] },
        "before_sha256": { "$ref": "#/$defs/sha256" },
        "after_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
